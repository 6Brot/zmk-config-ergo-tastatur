#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp A  &kp B  &kp C         &kp D         &kp E         &kp F         &kp G         &kp H         &kp I         &kp J
&kp K  &kp L  &kp M         &kp N         &kp O         &kp P         &kp Q         &kp R         &kp S         &kp T
&kp U  &kp V  &kp W         &kp X         &kp Y         &kp Z         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4
              &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_9  &kp NUMBER_0  &kp NUMBER_7  &kp NUMBER_8
            >;
        };
    };
};
